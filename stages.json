        "intro": { "ja": "焼かれた分を植え直す。森の規模が目標に届けば勝ち。", "en": "Replant what burned. Reach the forest target to win." } },

      { "id": "3-4", "chapter": 3, "name": { "ja": "火の尾根", "en": "Ridge of Fire" },
        "rounds": 16, "terrain": "inherit", "fireSpread": 1.25,
        "waves": [ { "round": 2, "kind": "fireman", "count": 3 }, { "round": 5, "kind": "killer", "count": 3 }, { "round": 9, "kind": "bald", "count": 3 }, { "round": 13, "kind": "fireman", "count": 3 } ] },

      { "id": "4-1", "chapter": 4, "name": { "ja": "還ってきた仲間", "en": "The Returned" },
        "rounds": 16,
        "terrain": { "seed": 404, "hills": 2, "hillRadius": 2, "river": "wide", "groveTrees": 2 },
        "waves": [ { "round": 3, "kind": "jikon", "count": 1 }, { "round": 6, "kind": "killer", "count": 3 }, { "round": 10, "kind": "bald", "count": 3 }, { "round": 14, "kind": "killer", "count": 3 } ],
