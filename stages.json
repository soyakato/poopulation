        "waves": [ { "round": 3, "kind": "bald", "count": 3 }, { "round": 8, "kind": "killer", "count": 3 }, { "round": 13, "kind": "fireman", "count": 3 } ],
        "intro": { "ja": "このステージで3匹産む。木を守り切れるかどうかの試験。", "en": "Bring three allies into the world. A test of holding trees." } },

