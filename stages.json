      { "id": "4-2", "chapter": 4, "name": { "ja": "沈黙の広間", "en": "Silent Hall" },
        "rounds": 17, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "killer", "count": 3 }, { "round": 6, "kind": "jikon", "count": 1 }, { "round": 10, "kind": "fireman", "count": 3 }, { "round": 14, "kind": "bald", "count": 3 } ] },

