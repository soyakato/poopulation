        "reinforce": { "perForest": 18, "max": 3 },
        "waves": [ { "round": 2, "kind": "killer", "count": 4 }, { "round": 6, "kind": "bald", "count": 4 }, { "round": 10, "kind": "fireman", "count": 4 }, { "round": 14, "kind": "jikon", "count": 2 }, { "round": 19, "kind": "killer", "count": 5 }, { "round": 23, "kind": "bald", "count": 5 }, { "round": 27, "kind": "jikon", "count": 3 } ],
        "intro": { "ja": "30ラウンド。ここを越えれば、糞は次の世代の土になる。", "en": "Thirty rounds. Survive and the poop becomes soil for the next generation." } }
