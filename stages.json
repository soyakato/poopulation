        "rounds": 20,
        "terrain": { "seed": 505, "hills": 4, "hillRadius": 3, "river": "wide", "groveTrees": 2 },
        "waves": [ { "round": 2, "kind": "fireman", "count": 3 }, { "round": 6, "kind": "bald", "count": 3 }, { "round": 11, "kind": "killer", "count": 4 }, { "round": 16, "kind": "jikon", "count": 1 } ],
        "intro": { "ja": "広い川が森を二分する。渡るのに2歩かかることを忘れずに。", "en": "A wide river splits the forest. Crossing costs two steps." } },

      { "id": "5-2", "chapter": 5, "name": { "ja": "掃討", "en": "Sweep" },
        "rounds": 20, "terrain": "inherit",
        "objective": { "type": "wipe" },
        "waves": [ { "round": 1, "kind": "killer", "count": 4 }, { "round": 5, "kind": "bald", "count": 4 }, { "round": 10, "kind": "fireman", "count": 4 } ] },

      { "id": "5-3", "chapter": 5, "name": { "ja": "長い燃焼", "en": "The Long Burn" },
        "rounds": 22, "terrain": "inherit", "fireSpread": 1.2,
        "waves": [ { "round": 3, "kind": "fireman", "count": 3 }, { "round": 7, "kind": "killer", "count": 4 }, { "round": 12, "kind": "bald", "count": 4 }, { "round": 17, "kind": "fireman", "count": 4 } ] },

