        "rounds": 24,
        "terrain": { "seed": 606, "hills": 3, "hillRadius": 2, "river": "narrow", "groveTrees": 3 },
        "waves": [ { "round": 2, "kind": "killer", "count": 4 }, { "round": 7, "kind": "bald", "count": 4 }, { "round": 12, "kind": "fireman", "count": 4 }, { "round": 18, "kind": "jikon", "count": 2 } ],
        "intro": { "ja": "最後の森。ここから先はもう逃げ場がない。", "en": "The last forest. There is nowhere left to fall back to." } },

      { "id": "6-2", "chapter": 6, "name": { "ja": "楽園を満たす", "en": "Fill the Sanctuary" },
        "rounds": 24, "terrain": "inherit",
        "objective": { "type": "forest", "target": 70 },
        "waves": [ { "round": 3, "kind": "fireman", "count": 4 }, { "round": 9, "kind": "bald", "count": 4 }, { "round": 15, "kind": "killer", "count": 5 }, { "round": 21, "kind": "fireman", "count": 4 } ] },

      { "id": "6-3", "chapter": 6, "name": { "ja": "人族の総力", "en": "All of Them" },
        "rounds": 26, "terrain": "inherit",
        "enemyScale": { "hp": 1.2, "atk": 1 },
        "waves": [ { "round": 2, "kind": "killer", "count": 4 }, { "round": 7, "kind": "jikon", "count": 2 }, { "round": 13, "kind": "bald", "count": 5 }, { "round": 19, "kind": "fireman", "count": 5 }, { "round": 24, "kind": "killer", "count": 5 } ] },

