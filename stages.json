        "waves": [ { "round": 1, "kind": "bald", "count": 3 }, { "round": 4, "kind": "killer", "count": 3 } ],
        "intro": { "ja": "この森からは、1人残らず追い出す。増援も含めて全滅させれば勝ち。", "en": "Clear every raider, including all reinforcements." } },

      { "id": "2-4", "chapter": 2, "name": { "ja": "前線の夜", "en": "Night on the Front" },
        "rounds": 12, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "bald", "count": 2 }, { "round": 5, "kind": "killer", "count": 3 }, { "round": 8, "kind": "bald", "count": 3 }, { "round": 11, "kind": "killer", "count": 2 } ] },

      { "id": "3-1", "chapter": 3, "name": { "ja": "焦げた稜線", "en": "Charred Ridge" },
