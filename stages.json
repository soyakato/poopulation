  "campaign": {
    "id": "forest-chronicle",
    "name": { "ja": "森の年代記", "en": "Forest Chronicle" },
    "targetPlayHours": 30,
    "startRoster": ["normal", "normal", "monkey"],

    "chapters": [
      { "id": 1, "name": { "ja": "第一章　うんちの目覚め", "en": "I — Poop Awakens" },
        "blurb": { "ja": "うんちが土になり、土が森になる。まだ誰も森を狙っていない。", "en": "Poop becomes soil, soil becomes forest. Nobody is hunting it yet." } },
      { "id": 2, "name": { "ja": "第二章　伐採前線", "en": "II — Logging Front" },
        "blurb": { "ja": "斧を持った人族が来る。木を守れなければ、仲間は生まれない。", "en": "Axes arrive. No protected trees, no newborn allies." } },
      { "id": 3, "name": { "ja": "第三章　火の尾根", "en": "III — Ridge of Fire" },
        "blurb": { "ja": "火は坂を駆け上がる。湿地が唯一の防火帯になる。", "en": "Fire runs uphill. The wetland is your only firebreak." } },
      { "id": 4, "name": { "ja": "第四章　支配の森", "en": "IV — Dominion Woods" },
        "blurb": { "ja": "ゴリラジコンが現れる。倒された仲間は、敵として還ってくる。", "en": "The Gorilla Jikon appears. Fallen allies come back as enemies." } },
      { "id": 5, "name": { "ja": "第五章　灰の湿原", "en": "V — Ash Marsh" },
        "blurb": { "ja": "焼け跡に水が入り、森は作り直しになる。総力戦が続く。", "en": "Water floods the burn scar. The forest must be rebuilt under fire." } },
      { "id": 6, "name": { "ja": "第六章　最後の楽園", "en": "VI — Last Sanctuary" },
        "blurb": { "ja": "残った森がすべて。ここを守り抜けば、次の世代に渡る。", "en": "What is left is all there is. Hold it and the bloodline continues." } }
    ],

    "stages": [
      { "id": "1-1", "chapter": 1, "name": { "ja": "苔の谷", "en": "Moss Hollow" },
        "rounds": 4,
        "terrain": { "seed": 101, "hills": 1, "hillRadius": 2, "river": "none", "groveTrees": 3 },
        "waves": [ { "round": 2, "kind": "killer", "count": 1 } ],
        "reinforce": { "perForest": 30, "max": 0 },
        "intro": { "ja": "実を食べ、うんちをして、森を広げる。それだけでいい。", "en": "Eat fruit, poop, spread the forest. That is all for now." } },

      { "id": "1-2", "chapter": 1, "name": { "ja": "陽だまりの縁", "en": "Sunlit Verge" },
        "rounds": 5, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "killer", "count": 1 }, { "round": 4, "kind": "killer", "count": 1 } ],
        "reinforce": { "perForest": 30, "max": 0 } },

      { "id": "1-3", "chapter": 1, "name": { "ja": "実りの窪地", "en": "Fruiting Basin" },
        "rounds": 6, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "killer", "count": 2 }, { "round": 5, "kind": "killer", "count": 1 } ],
        "reinforce": { "perForest": 28, "max": 1 } },

      { "id": "1-4", "chapter": 1, "name": { "ja": "はじめての産声", "en": "First Cry" },
        "rounds": 8, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "killer", "count": 2 }, { "round": 5, "kind": "killer", "count": 2 }, { "round": 7, "kind": "killer", "count": 2 } ],
        "reinforce": { "perForest": 25, "max": 1 } },

      { "id": "2-1", "chapter": 2, "name": { "ja": "斧の音", "en": "Sound of Axes" },
        "rounds": 9,
        "terrain": { "seed": 202, "hills": 2, "hillRadius": 2, "river": "narrow", "groveTrees": 3 },
        "waves": [ { "round": 2, "kind": "bald", "count": 2 }, { "round": 5, "kind": "killer", "count": 2 }, { "round": 8, "kind": "bald", "count": 2 } ],
        "intro": { "ja": "ハゲは成木を狙う。木を1本失うたび、出生の時計は0に戻る。", "en": "The bald ones fell mature trees. Every loss resets a birth timer." } },

      { "id": "2-2", "chapter": 2, "name": { "ja": "切り株の列", "en": "Row of Stumps" },
        "rounds": 10, "terrain": "inherit",
        "waves": [ { "round": 2, "kind": "killer", "count": 2 }, { "round": 4, "kind": "bald", "count": 2 }, { "round": 7, "kind": "killer", "count": 2 }, { "round": 9, "kind": "bald", "count": 2 } ] },

      { "id": "2-3", "chapter": 2, "name": { "ja": "追い落とし", "en": "Drive Them Out" },
