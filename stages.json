        "terrain": { "seed": 303, "hills": 3, "hillRadius": 3, "river": "narrow", "groveTrees": 2 },
        "fireSpread": 1.15,
        "waves": [ { "round": 2, "kind": "fireman", "count": 2 }, { "round": 5, "kind": "killer", "count": 2 }, { "round": 9, "kind": "fireman", "count": 2 } ],
        "intro": { "ja": "火は高いほうへ走る。湿地の青い木は燃えない。", "en": "Fire climbs. The blue wetland trees will not burn." } },

      { "id": "3-2", "chapter": 3, "name": { "ja": "煙の谷", "en": "Valley of Smoke" },
        "rounds": 13, "terrain": "inherit", "fireSpread": 1.15,
        "waves": [ { "round": 2, "kind": "fireman", "count": 2 }, { "round": 4, "kind": "bald", "count": 2 }, { "round": 7, "kind": "fireman", "count": 2 }, { "round": 10, "kind": "killer", "count": 3 } ] },

